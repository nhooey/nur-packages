#!/usr/bin/env bash
# sudo stand-in for tests/background-items/unit.bats: logs the call and runs
# the command as the current user.
set -euo pipefail
printf 'sudo %s\n' "$*" >>"$STUB_LOG"
while [ $# -gt 0 ]; do
  case $1 in
  --)
    shift
    break
    ;;
  -*) shift ;;
  *) break ;;
  esac
done
exec "$@"
